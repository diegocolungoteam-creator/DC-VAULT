<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Cambia BRAND y USER. Cópialo a ~/Library/LaunchAgents/ y carga con:
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.BRAND.contentengine.plist -->
    <key>Label</key><string>com.BRAND.contentengine</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USER/content-engine/.venv/bin/python</string>
        <string>/Users/USER/content-engine/weekly_engine.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/USER/content-engine</string>
    <!-- Los dos hacen falta: RunAtLoad solo dispara al iniciar sesión (sin wifi aún);
         StartInterval reintenta cada 6 h. El throttle de 7 días decide cuándo trabaja. -->
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>21600</integer>
    <key>StandardOutPath</key><string>/Users/USER/content-engine/engine.log</string>
    <key>StandardErrorPath</key><string>/Users/USER/content-engine/engine.log</string>
</dict>
</plist>
